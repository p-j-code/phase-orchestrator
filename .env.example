# Ashmero Orchestrator — environment overrides
# Copy to .env to use. Most config lives in config/ and project.json — this is
# only for machine-specific paths and secrets.

# Optional: explicit claude binary path. If unset, orchestrator reads from
# ~/.ashmero-orchestrator/user.json or falls back to PATH lookup.
# CLAUDE_BIN=/usr/local/bin/claude

# Hard guard — orchestrator refuses to run if this is set.
# DO NOT set ANTHROPIC_API_KEY here. Max OAuth handles billing.
# ANTHROPIC_API_KEY=

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# Override SQLite path (default: ./state/orchestrator.db)
# DB_PATH=./state/orchestrator.db
